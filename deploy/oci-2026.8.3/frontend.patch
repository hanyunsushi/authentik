+        gap: 0 8px;
+    }
+    .brand {
+        display: none;
+    }
+    .page-title {
+        font-size: 16px;
+        line-height: 20px;
+    }
+    .items.primary {
+        padding-block: 6px 0;
+    }
+    .items.page-description {
+        display: none;
+    }
+}
+
+/* 折叠按钮：宽屏仍可操作，保持 32px/44px 命中区域而非整栏拉伸。 */
+slot[name="toggle"] {
+    display: contents;
+}

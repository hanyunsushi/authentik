+    height: var(--ak-first-button-height);
+    align-self: center;
+}
+.items.secondary {
+    padding: 0;
+}
+
+/* 品牌标识：折叠轨道保留原品牌图左侧标识，展开仍显示完整品牌图。 */
+.brand {
+    container-type: inline-size;
+}
+@container (width < 80px) {
+    .logo img {
+        width: 40px;
+        height: 40px;
+        object-fit: cover;
+        object-position: left;
+    }
+}
+
+/* 顶栏：品牌在全高侧栏，内容顶栏从正文边界开始，不重复占264px列。 */
+.main-content {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    grid-template-areas: "toggle primary secondary" "toggle description secondary";
+    padding-inline: 20px;
+}
+.brand {
+    display: none;
+}
+@media (width <= 768px) {
+    .main-content {
+        padding-inline: 8px;
+    }
+}
+
+/* 顶栏：明确覆盖PF Content的h1规则，应用标题按16/20、650正文合同显示。 */
+.pf-c-content .page-title {
+    font: 650 16px/20px var(--ak-first-body);
+}

+:host {
+    --ak-c-page-navbar--Height: 64px;
+    display: block;
+    min-width: 0;
+}
+.main-content {
+    height: 64px;
+    min-height: 64px;
+    grid-template-columns: var(--ak-first-shell-sidebar, 264px) auto minmax(0, 1fr) auto;
+    grid-template-areas: "brand toggle primary secondary" "brand toggle description secondary";
+    grid-template-rows: 1fr auto;
+    gap: 0 12px;
+    padding-inline-end: 20px;
+    border-bottom: 1px solid var(--ak-first-border);
+    background: var(--ak-first-glass);
+    backdrop-filter: blur(22px) saturate(1.5);
+    box-shadow: none;
+}
+.brand {
+    display: flex;
+    width: 100%;
+    min-width: 0;
+    height: 64px;
+    padding: 10px 16px;
+    background: transparent;
+    border-inline-end: 1px solid var(--ak-first-border);
+}
+.brand .logo {
+    max-width: 100%;
+}
+.brand img {
+    max-width: 100%;
+    max-height: 40px;
+    width: auto;
+    object-fit: contain;
+}
+.items.primary,
+.items.primary.block-sibling {
+    min-width: 0;
+    padding-block: 6px 0;
+    align-self: center;
+}
+.page-title {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    margin: 0;
+    font: 650 16px/20px var(--ak-first-body);
+}
+.page-title > span {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+.items.page-description {
+    margin: 0;
+    padding-block: 0 7px;
+    font-size: 12px;
+    line-height: 16px;
+    -webkit-line-clamp: 1;
+}
+.items.secondary {
+    min-width: 0;
+    align-self: center;
+    grid-row: 1 / -1;
+}
+.items .accent-icon {
+    color: var(--ak-first-text-2);
+}
+@media (width <= 768px) {
+    .main-content {
+        grid-template-columns: auto minmax(0, 1fr) auto;
+        grid-template-areas: "toggle primary secondary" "toggle description secondary";
